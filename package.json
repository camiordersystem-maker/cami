{
  "name": "cami-order-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:member": "next dev --webpack -p 3000",
    "dev:admin": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx src/lib/__tests__/business-rules.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx src/lib/db/migrate.ts",
    "db:migrate:pg": "npx tsx src/lib/db/migrate.pg.ts",
    "db:verify": "npx tsx scripts/verify-schema.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "npx tsx src/lib/db/seed.ts",
    "seed:pg": "npx tsx src/lib/db/seed.pg.ts",
    "seed:staging": "npx tsx scripts/seed-staging.ts",
    "reset:staging": "npx tsx scripts/reset-staging.ts",
    "preflight": "npx tsx scripts/preflight.ts",
    "smoke:production": "npx tsx scripts/smoke-production.ts",
    "release:production": "npx tsx scripts/release-production.ts",
    "vercel-build": "next build --webpack",
    "local:setup": "tsx scripts/local-setup.ts",
    "local:start": "docker compose up -d",
    "local:stop": "docker compose stop",
    "local:reset": "tsx scripts/local-reset.ts",
    "local:seed": "tsx scripts/local-seed.ts",
    "local:verify": "tsx scripts/local-verify.ts",
    "local:test": "npm run typecheck && npm test && npm run db:verify",
    "local:backup": "tsx scripts/local-backup.ts",
    "local:restore": "tsx scripts/local-restore.ts",
    "local:smoke": "tsx scripts/local-smoke.ts",
    "scan:secrets": "tsx scripts/secret-scan.ts",
    "docs:generate": "tsx scripts/generate-handover-docs.ts",
    "local:migrate": "tsx scripts/local-migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.20.0",
    "@vercel/blob": "^2.4.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.15",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
